// Router — client-side (SPA) routing. Maps a URL path to a root Component, reusing
// zaia.core's RoutePattern (the same matcher the server router uses). Modeled after
// ASP.NET routing: patterns are tried in order; the first match builds its component.
//
//   var router = new Router()
//       .Map("/",          new HomeRoute())
//       .Map("/users/{id}", new UserRoute());
//   Component page = router.Resolve("/users/42");   // → UserRoute.Build(match)
//
// A route builder is a nominal `RouteHandler` (not a delegate) for the same reason
// the change seam is: a named class crosses zpkg boundaries cleanly, and Build gets
// the RouteMatch so it can read captured segments. Binding this to the browser's
// history/location (pushState + popstate) is the next step and needs the DOM
// primitives; the resolve logic here is platform-agnostic and testable today.
namespace Zaia.App;

using Std;
using Std.Collections;
using Zaia.Core;
using Zaia.Ui;

// Builds the root Component for a matched route (captured params in `match`).
public abstract class RouteHandler {
    public abstract Component Build(RouteMatch match);
}

public class Router {
    private List<RoutePattern> _patterns;
    private List<RouteHandler> _handlers;

    public Router() {
        this._patterns = new List<RoutePattern>();
        this._handlers = new List<RouteHandler>();
    }

    public Router Map(string pattern, RouteHandler handler) {
        this._patterns.Add(RoutePattern.Parse(pattern));
        this._handlers.Add(handler);
        return this;
    }

    // Resolve a path to its component, or null if no pattern matches.
    public Component Resolve(string path) {
        int i = 0;
        while (i < this._patterns.Count) {
            RouteMatch m = this._patterns[i].Match(path);
            if (m.Matched) {
                RouteHandler h = this._handlers[i];
                return h.Build(m);
            }
            i = i + 1;
        }
        return null;
    }
}

// Result<T> — an explicit success-or-failure outcome, platform-agnostic. Used by
// framework code (and yours) where a call can fail without throwing: a route bind,
// a service resolve, a typed client call. It is NOT the server handler return type
// (handlers stay imperative — they call ctx.Json / ctx.Text directly); it is the
// value type you reach for in your own logic and in the typed client seam.
//
//   Result<User> r = Users.Find(id);
//   if (r.Ok) { use(r.Value); } else { log(r.Error); }
namespace Zaia.Core;

using Std;

public class Result<T> {
    public bool Ok;
    public T Value;
    public string Error;

    private Result() { }

    public static Result<T> Success(T value) {
        Result<T> r = new Result<T>();
        r.Ok = true;
        r.Value = value;
        r.Error = "";
        return r;
    }

    public static Result<T> Failure(string error) {
        Result<T> r = new Result<T>();
        r.Ok = false;
        r.Error = error;
        return r;
    }
}

// RoutePattern — compiles a route template like "/users/{id}/posts/{slug}" and
// matches request paths against it, capturing the named segments.
//
// Platform-agnostic (no net, no DOM): the same matcher powers the server router
// and the client-side router.
namespace Zaia.Core;

using Std;
using Std.Collections;

// The outcome of matching a path against a RoutePattern.
public class RouteMatch {
    public bool Matched;
    public Dictionary<string, string> Params;

    public RouteMatch(bool matched) {
        this.Matched = matched;
        this.Params = new Dictionary<string, string>();
    }

    public static RouteMatch Fail() { return new RouteMatch(false); }
}

// A parsed route template. Segments beginning with '{' are captures.
public class RoutePattern {
    private string[] _segments;

    public RoutePattern(string template) {
        this._segments = _splitPath(template);
    }

    public static RoutePattern Parse(string template) {
        return new RoutePattern(template);
    }

    // Match a concrete request path. Returns a RouteMatch whose Matched flag says
    // whether the path fits, and whose Params holds every captured segment.
    public RouteMatch Match(string path) {
        string[] parts = _splitPath(path);
        if (parts.Length != this._segments.Length) { return RouteMatch.Fail(); }

        RouteMatch m = new RouteMatch(true);
        int i = 0;
        while (i < this._segments.Length) {
            string seg = this._segments[i];
            if (seg.StartsWith("{") && seg.EndsWith("}")) {
                string name = seg.Substring(1, seg.Length - 2);
                m.Params.Set(name, parts[i]);
            } else if (seg != parts[i]) {
                return RouteMatch.Fail();
            }
            i = i + 1;
        }
        return m;
    }

    // Split "/a/b/" into ["a","b"] — leading/trailing slashes and empty segments dropped.
    private static string[] _splitPath(string path) {
        List<string> outSegs = new List<string>();
        string[] raw = path.Split("/");
        int i = 0;
        while (i < raw.Length) {
            if (raw[i].Length > 0) { outSegs.Add(raw[i]); }
            i = i + 1;
        }
        return outSegs.ToArray();
    }
}

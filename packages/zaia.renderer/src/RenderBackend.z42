// RenderBackend — the seam that makes rendering backend-agnostic. The reconciler
// speaks only these operations; a concrete backend maps them to a real target:
//
//   • DomBackend   (zaia.web)  → the live browser DOM, via the VM __dom_* builtins
//   • HtmlBackend  (zaia.renderer) → an HTML string, for server-side rendering
//   • a test backend           → an in-memory tree, for assertions
//
// Modeled after Blazor's renderer abstraction (a small imperative mutation API a
// diff can target), not on the DOM API itself. Nodes are opaque integer handles;
// each backend keeps its own handle → node map. The op set is the minimum a
// keyed-diff patcher needs: create, set text/attribute, append, clear, listen.
namespace Zaia.Renderer;

using Std;

public abstract class RenderBackend {
    // The mount point for a root render (e.g. a CSS selector on the client).
    public abstract int Root(string selector);

    public abstract int CreateElement(string tag);
    public abstract int CreateText(string text);

    public abstract void SetText(int node, string text);
    public abstract void SetAttribute(int node, string name, string value);
    public abstract void AppendChild(int parent, int child);

    // Remove every child of `node` — the PoC reconciler's reset before a rebuild
    // (a keyed diff will use finer-grained removes instead).
    public abstract void Clear(int node);

    // Attach an event handler (non-capturing Action for now — the DOM PoC constraint).
    public abstract void On(int node, string eventName, Action handler);
}

// App / Renderer — mounts a root component and drives the resident render loop.
//
// The renderer patches a VNode tree onto the real DOM through the VM DOM builtins
// (`__dom_create_element`, `__dom_add_event_listener`, …). Those are added by the
// z42 change `add-wasm-dom-poc` and ship in a nightly SDK; until they are present
// the renderer throws a clear error, so the rest of the framework stays buildable.
namespace Zaia.Web;

using Std;

public static class App {
    // Mount `root` under the CSS selector and start rendering. Leaves the VM
    // resident so DOM events re-enter z42.
    public static void Mount(string selector, Component root) {
        Renderer.MountRoot(selector, root);
    }

    public static void RequestRender(Component c) { Renderer.Schedule(c); }
}

public static class Renderer {
    public static void MountRoot(string selector, Component root) {
        throw new Exception(
            "zaia.web renderer needs the VM DOM primitives (z42 change add-wasm-dom-poc); "
            + "not present in this SDK yet");
    }

    public static void Schedule(Component c) {
        throw new Exception("zaia.web renderer not yet available in this SDK");
    }
}

// DomBackend — the browser RenderBackend. Implements the render seam over the VM
// DOM builtins (__dom_create_element, __dom_add_event_listener, …). Those are
// added by the z42 change `add-wasm-dom-poc`; until they ship the operations throw,
// so the framework compiles but a client render fails fast with a clear message.
namespace Zaia.Web;

using Std;
using Zaia.Renderer;

public class DomBackend : RenderBackend {
    public override int Root(string selector)               { return _nyi(); }
    public override int CreateElement(string tag)           { return _nyi(); }
    public override int CreateText(string text)             { return _nyi(); }
    public override void SetText(int node, string text)     { _nyiVoid(); }
    public override void AppendChild(int parent, int child) { _nyiVoid(); }
    public override void OnClick(int node, Action handler)  { _nyiVoid(); }

    private static int _nyi() {
        throw new Exception(
            "zaia.web DomBackend needs the VM DOM primitives (z42 change "
            + "add-wasm-dom-poc); not present in this SDK yet");
    }
    private static void _nyiVoid() { _nyi(); }
}

// Component — the unit of UI description. Subclass it and override Render() to
// describe the view as a VNode tree. Call StateChanged() (or mutate a State<T>)
// after changing data; the description just signals — the app decides what to do.
namespace Zaia.Ui;

using Std;

public abstract class Component {
    public abstract VNode Render();

    // Signal that this component's data changed. Routed through UiDispatch so the
    // description layer stays unaware of the renderer.
    public void StateChanged() { UiDispatch.NotifyChanged(this); }
}

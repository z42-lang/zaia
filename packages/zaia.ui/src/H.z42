// H — the element factory. `H.Div(H.H1("hi"), H.Button("go"))` describes markup.
//
// Two primitives cover every tag — `El(tag, children…)` for containers and
// `Leaf(tag, text)` for text nodes — with sugars for the common elements. Anything
// else is `H.El("article", …)` plus fluent `.Attr(...)` on the result, so the
// factory stays thin while the tag vocabulary stays open.
namespace Zaia.Ui;

using Std;
using Std.Collections;

public static class H {
    // ── primitives (any tag) ────────────────────────────────────────────────
    public static VNode El(string tag, params VNode[] children) {
        VNode n = new VNode(tag);
        int i = 0;
        while (i < children.Length) { n.Children.Add(children[i]); i = i + 1; }
        return n;
    }

    public static VNode Leaf(string tag, string text) {
        VNode n = new VNode(tag);
        n.Text = text;
        return n;
    }

    public static VNode Text(string text) { return Leaf("", text); }

    // ── container sugars ────────────────────────────────────────────────────
    public static VNode Div(params VNode[] children)     { return El("div", children); }
    public static VNode Span(params VNode[] children)    { return El("span", children); }
    public static VNode P(params VNode[] children)       { return El("p", children); }
    public static VNode Section(params VNode[] children) { return El("section", children); }
    public static VNode Header(params VNode[] children)  { return El("header", children); }
    public static VNode Footer(params VNode[] children)  { return El("footer", children); }
    public static VNode Nav(params VNode[] children)     { return El("nav", children); }
    public static VNode Ul(params VNode[] children)      { return El("ul", children); }
    public static VNode Li(params VNode[] children)      { return El("li", children); }

    // ── leaf sugars ─────────────────────────────────────────────────────────
    public static VNode H1(string text)     { return Leaf("h1", text); }
    public static VNode H2(string text)     { return Leaf("h2", text); }
    public static VNode H3(string text)     { return Leaf("h3", text); }
    public static VNode Label(string text)  { return Leaf("label", text); }
    public static VNode Button(string text) { return Leaf("button", text); }

    // ── attribute-carrying sugars ───────────────────────────────────────────
    public static VNode A(string href, string text) {
        VNode n = Leaf("a", text);
        n.Attr("href", href);
        return n;
    }

    public static VNode Input(string type, string placeholder) {
        VNode n = new VNode("input");
        n.Attr("type", type);
        n.Attr("placeholder", placeholder);
        return n;
    }
}

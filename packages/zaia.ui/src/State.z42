// State<T> — the "data update" primitive of the description layer. A reactive cell:
// read Get() in Render() to reflect current data; call Set() to update it, which
// fires a change signal so the app re-renders. Declaring data this way means you
// never wire the update to the renderer by hand — describe the data, mutate it,
// the UI follows.
//
//   class Counter : Component {
//       State<int> _count = new State<int>(0);
//       override VNode Render() =>
//           H.Div(
//               H.H1("Count: " + _count.Get().ToString()),
//               H.Button("+").OnClick(() => _count.Set(_count.Get() + 1))
//           );
//   }
namespace Zaia.Ui;

using Std;

public class State<T> {
    private T _value;

    public State(T initial) { this._value = initial; }

    public T Get() { return this._value; }

    public void Set(T value) {
        this._value = value;
        UiDispatch.NotifyChanged(null);   // data changed → app schedules a re-render
    }
}
